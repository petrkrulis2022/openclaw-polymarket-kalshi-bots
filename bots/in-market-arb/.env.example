PORT=3005
BOT_ID=4
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
BOT_SIGNER_KEY=
ORCHESTRATOR_URL=http://localhost:3002
TREASURY_URL=http://localhost:3001

# Venue selection: polymarket (default) | kalshi | limitless | opinion
VENUE=polymarket

# Limitless (CLOB on Base, chain 8453) — only needed when VENUE=limitless.
# Public reads (markets/orderbook) need no auth; trading needs a scoped API token.
LIMITLESS_API_BASE=https://api.limitless.exchange
LIMITLESS_API_KEY=
LIMITLESS_API_SECRET=
BASE_RPC_URL=https://mainnet.base.org
# The scoped API token is bound to the wallet you connected in the Limitless app.
# The bot MUST sign orders with THAT wallet's private key, or orders are rejected.
# Set this to that wallet's key (NOT the derived bot EOA, which is a different addr).
LIMITLESS_SIGNER_KEY=
# Trader wallet (must equal the wallet the API token was issued for).
LIMITLESS_WALLET_ADDRESS=
LIMITLESS_FEE_RATE=0.02

# Arb parameters
SCAN_INTERVAL_MS=60000
MAX_CONCURRENT_MARKETS=10
MIN_SPREAD_THRESHOLD=0.005
FEE_THRESHOLD=0.002
PAIR_TIMEOUT_MS=10000
MAX_POSITION_USD=50
